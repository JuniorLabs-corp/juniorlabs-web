---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../content/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.meta.title, description = site.meta.description } = Astro.props;

// Solo hay canonical si astro.config define `site`; sin él, la URL absoluta no se puede construir.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/icon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#F4F7FA" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0B1730" media="(prefers-color-scheme: dark)" />
	</head>
	<body class="min-h-dvh">
		<a
			href="#contenido"
			class="sr-only rounded-full bg-accent font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2"
		>
			Saltar al contenido
		</a>

		<header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-md">
			<Navbar />
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer id="contacto" class="border-t border-border">
			<Footer />
		</footer>
	</body>
</html>
