---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoLight from '../assets/brand/logo-light.svg';
import LogoDark from '../assets/brand/logo-dark.svg';
---

<BaseLayout>
	<main class="grid min-h-dvh place-items-center gap-6 p-6 text-center">
		<div>
			<LogoLight class="mx-auto h-16 w-auto dark:hidden" aria-label="Junior Labs" />
			<LogoDark class="mx-auto hidden h-16 w-auto dark:block" aria-label="Junior Labs" />
			<h1 class="mt-8 font-mono text-4xl font-bold tracking-tight">Software que despega.</h1>
			<p class="mt-3 text-text-secondary">Landing en construcción.</p>
		</div>
	</main>
</BaseLayout>
