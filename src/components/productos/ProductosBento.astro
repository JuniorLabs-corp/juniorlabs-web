---
/**
 * Bento Grid de /productos: una columna en móvil, 2 en tableta y 4 en escritorio.
 * Los recuadros salen de content/productos.ts (upcomingProducts); su `size` decide cuánto ocupan.
 */
import ProductoSlot from './ProductoSlot.astro';
import { upcomingProducts, type ProductoSlot as Slot } from '../../content/productos';

interface Props {
	/** Nombre de la lista para lectores de pantalla. */
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
const slots: Slot[] = upcomingProducts;
---

<!-- role="list": Safari/VoiceOver quita la semántica de lista cuando list-style es none -->
<ul role="list" aria-label={label} class:list={['bento', className]}>
	{slots.map((slot) => <ProductoSlot item={slot} />)}
</ul>

<style>
	@layer components {
		.bento {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 1rem;
		}

		@media (width >= 40rem) {
			.bento {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				grid-auto-rows: 11rem;
				/* dense: si un producto publicado cambia de tamaño, los demás rellenan los huecos */
				grid-auto-flow: dense;
				gap: 1.5rem;
			}
		}

		@media (width >= 64rem) {
			.bento {
				grid-template-columns: repeat(4, minmax(0, 1fr));
				grid-auto-rows: 12.5rem;
			}
		}
	}
</style>
