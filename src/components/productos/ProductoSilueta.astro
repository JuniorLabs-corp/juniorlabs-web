---
/**
 * Wireframe abstracto de una pantalla de software (decorativo). Va debajo del velo esmerilado del recuadro,
 * así que solo se adivinan formas: nunca debe leerse como una captura real.
 * Usa currentColor (el recuadro lo pone en --text-secondary) y --accent para un solo detalle por silueta.
 */
import type { ProductoSilueta } from '../../content/productos';

interface Props {
	variant: ProductoSilueta;
	class?: string;
}

const { variant, class: className } = Astro.props;

// Las siluetas altas o con columna lateral se anclan arriba a la izquierda para no perder su estructura al recortarse
const anchor: Record<ProductoSilueta, string> = {
	panel: 'xMinYMin slice',
	lista: 'xMinYMin slice',
	grafica: 'xMidYMax slice',
	calendario: 'xMidYMid slice',
	formulario: 'xMinYMid slice',
	mensajes: 'xMidYMid slice',
};

const rows = Array.from({ length: 9 }, (_, i) => i);
const bars = [120, 190, 150, 240, 205, 280, 230, 310];
const cells = Array.from({ length: 35 }, (_, i) => i);
const accentCells = new Set([9, 10, 17, 25]);
const bubbles = [
	{ side: 'left', w: 210, h: 44 },
	{ side: 'right', w: 170, h: 36 },
	{ side: 'left', w: 250, h: 60 },
	{ side: 'right', w: 200, h: 36 },
	{ side: 'left', w: 150, h: 36 },
	{ side: 'right', w: 230, h: 52 },
];
let bubbleY = 24;
const placedBubbles = bubbles.map((b) => {
	const y = bubbleY;
	bubbleY += b.h + 16;
	return { ...b, y, x: b.side === 'left' ? 20 : 380 - b.w };
});
---

<svg
	class:list={['silueta', className]}
	viewBox="0 0 400 400"
	preserveAspectRatio={anchor[variant]}
	aria-hidden="true"
	focusable="false"
>
	{
		variant === 'panel' && (
			<g>
				<rect class="fill-soft" x="0" y="0" width="88" height="400" />
				{[0, 1, 2, 3, 4, 5].map((i) => (
					<rect class="fill-mid" x="20" y={40 + i * 34} width={i === 0 ? 48 : 40} height="10" rx="5" />
				))}
				<rect class="fill-faint" x="88" y="0" width="312" height="52" />
				<rect class="fill-mid" x="112" y="16" width="140" height="20" rx="10" />
				{[112, 206, 300].map((x) => (
					<g>
						<rect class="fill-soft stroke" x={x} y="76" width="84" height="70" rx="12" />
						<rect class="fill-mid" x={x + 14} y="94" width="36" height="8" rx="4" />
						<rect class="fill-strong" x={x + 14} y="112" width="52" height="14" rx="5" />
					</g>
				))}
				<rect class="fill-faint stroke" x="112" y="168" width="272" height="140" rx="14" />
				<polyline
					class="line-accent"
					points="128,280 168,250 208,262 248,214 288,228 328,188 368,200"
				/>
				{[326, 350, 374].map((y) => (
					<rect class="fill-soft" x="112" y={y} width="272" height="14" rx="7" />
				))}
			</g>
		)
	}
	{
		variant === 'lista' && (
			<g>
				{rows.map((i) => {
					const y = 24 + i * 44;
					return (
						<g>
							<circle class="fill-mid" cx="40" cy={y + 14} r="14" />
							<rect class="fill-strong" x="68" y={y + 3} width={150 + ((i * 37) % 60)} height="10" rx="5" />
							<rect class="fill-soft" x="68" y={y + 19} width={90 + ((i * 23) % 50)} height="8" rx="4" />
							<rect class={i === 1 ? 'fill-accent' : 'fill-soft'} x="300" y={y + 5} width="64" height="18" rx="9" />
						</g>
					);
				})}
			</g>
		)
	}
	{
		variant === 'grafica' && (
			<g>
				{[100, 180, 260].map((y) => (
					<rect class="fill-faint" x="24" y={y} width="352" height="2" />
				))}
				<rect class="fill-mid" x="24" y="340" width="352" height="3" />
				{bars.map((h, i) => (
					<rect class={i === 5 ? 'fill-accent' : 'fill-mid'} x={38 + i * 43} y={340 - h} width="26" height={h} rx="6" />
				))}
			</g>
		)
	}
	{
		variant === 'calendario' && (
			<g>
				<rect class="fill-strong" x="15" y="28" width="120" height="16" rx="8" />
				<rect class="fill-soft" x="305" y="26" width="80" height="20" rx="10" />
				{cells.map((i) => {
					const x = 15 + (i % 7) * 54;
					const y = 72 + Math.floor(i / 7) * 62;
					return (
						<rect class={accentCells.has(i) ? 'fill-accent' : 'fill-faint stroke'} x={x} y={y} width="46" height="54" rx="10" />
					);
				})}
			</g>
		)
	}
	{
		variant === 'formulario' && (
			<g>
				{[40, 124, 208].map((y, i) => (
					<g>
						<rect class="fill-mid" x="20" y={y} width={[90, 120, 70][i]} height="10" rx="5" />
						<rect class="fill-faint stroke" x="20" y={y + 20} width="360" height="42" rx="12" />
						<rect class="fill-soft" x="36" y={y + 36} width={[160, 110, 200][i]} height="10" rx="5" />
					</g>
				))}
				<rect class="fill-accent" x="20" y="316" width="150" height="46" rx="23" />
				<rect class="fill-soft" x="186" y="316" width="110" height="46" rx="23" />
			</g>
		)
	}
	{
		variant === 'mensajes' && (
			<g>
				{placedBubbles.map((b, i) => (
					<rect class={b.side === 'right' && i === 1 ? 'fill-accent' : b.side === 'right' ? 'fill-mid' : 'fill-soft stroke'} x={b.x} y={b.y} width={b.w} height={b.h} rx="18" />
				))}
				<rect class="fill-faint stroke" x="20" y="344" width="300" height="40" rx="20" />
				<circle class="fill-accent" cx="356" cy="364" r="20" />
			</g>
		)
	}
</svg>

<style>
	@layer components {
		.silueta {
			display: block;
			width: 100%;
			height: 100%;
		}

		.fill-faint {
			fill: currentColor;
			fill-opacity: 0.07;
		}

		.fill-soft {
			fill: currentColor;
			fill-opacity: 0.14;
		}

		.fill-mid {
			fill: currentColor;
			fill-opacity: 0.26;
		}

		.fill-strong {
			fill: currentColor;
			fill-opacity: 0.38;
		}

		.fill-accent {
			fill: var(--accent);
			fill-opacity: 0.5;
		}

		.stroke {
			stroke: currentColor;
			stroke-opacity: 0.22;
			stroke-width: 1.5;
		}

		.line-accent {
			fill: none;
			stroke: var(--accent);
			stroke-opacity: 0.8;
			stroke-width: 4;
			stroke-linecap: round;
			stroke-linejoin: round;
		}
	}
</style>
