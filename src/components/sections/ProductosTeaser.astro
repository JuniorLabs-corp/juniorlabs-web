---
/**
 * Sección Productos de la home (#productos): título, intro, botón a /productos y la ficha de aviso.
 * El estado (En desarrollo, Próximamente…) lo muestra cada ficha, no la sección.
 */
import Container from '../layout/Container.astro';
import ProductosListado from './ProductosListado.astro';
import { site } from '../../content/site';

const { id, title, intro, cta } = site.productos;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-section">
	<Container class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
		<div>
			<h2 id={`${id}-title`} class="section-title">{title}</h2>
			<p class="mt-4 max-w-[38ch] text-lg leading-relaxed text-pretty text-text-secondary">{intro}</p>
			<div class="mt-8">
				<a href={cta.href} class="productos-cta border border-border text-text hover:border-text-secondary hover:bg-surface">
					{cta.label}
				</a>
			</div>
		</div>

		<ProductosListado itemHeading="h3" />
	</Container>
</section>

<style>
	@layer components {
		/* Botón secundario, igual al del hero y al de Quiénes somos */
		.productos-cta {
			display: inline-flex;
			align-items: center;
			min-height: 3rem;
			padding-inline: 1.5rem;
			border-radius: 9999px;
			font-weight: 600;
			transition:
				transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
				background-color 150ms ease,
				border-color 150ms ease;
		}

		.productos-cta:active {
			transform: scale(0.97);
		}

		@media (prefers-reduced-motion: reduce) {
			.productos-cta {
				transition:
					background-color 150ms ease,
					border-color 150ms ease;
			}

			.productos-cta:active {
				transform: none;
			}
		}
	}
</style>
