---
/**
 * Fichas de aviso de productos (site.productos.items) en la sección de la home.
 * Hoy hay una sola ficha pendiente; para publicar un producto se agrega un elemento en site.ts.
 * La página /productos muestra el Bento Grid (components/productos/ProductosBento.astro).
 */
import { site, type FichaProducto } from '../../content/site';
import { splitContactWord } from '../../lib/contact-link';

interface Props {
	/** Nivel del título de cada ficha: un nivel debajo del título de la sección. */
	itemHeading?: 'h2' | 'h3';
}

const { itemHeading = 'h3' } = Astro.props;
const ItemHeading = itemHeading;
const items: FichaProducto[] = site.productos.items;
const { mailto } = site.contact;

const withContactLink = ({ name, description, contactWord }: FichaProducto) =>
	splitContactWord(description, contactWord, `site.productos («${name}»)`);
---

<!-- role="list": Safari/VoiceOver quita la semántica de lista cuando list-style es none -->
<ul role="list" class="grid gap-4 sm:gap-6">
	{
		items.map((item) => {
			const desc = withContactLink(item);
			return (
				<li>
					{/* El estado va después del nombre en el DOM (quien navega por títulos lo oye) y se muestra arriba con order */}
					<article data-producto class="producto flex flex-col">
						<ItemHeading class="mt-4 text-lg font-semibold sm:text-xl">{item.name}</ItemHeading>
						<p class="status order-first self-start">
							<span class="status-dot" aria-hidden="true" />
							{item.status}
						</p>
						<p class="mt-2 max-w-[52ch] leading-relaxed text-pretty text-text-secondary">
							{desc.before}
							{desc.word && (
								<a href={mailto} class="contact-link">
									{desc.word}
								</a>
							)}
							{desc.after}
						</p>
					</article>
				</li>
			);
		})
	}
</ul>

<style>
	@layer components {
		.producto {
			padding: 1.5rem;
			border-radius: 1.25rem;
			background: var(--surface);
			border: 1px solid var(--border);
		}

		@media (width >= 40rem) {
			.producto {
				padding: 2rem;
			}
		}

		/* Estado: punto + texto, para que no dependa solo del color */
		.status {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.25rem 0.75rem;
			border-radius: 9999px;
			border: 1px solid var(--border);
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--text);
		}

		.status-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 9999px;
			background: var(--accent);
		}

		/* Texto en --text (contraste AA en claro); el acento va en el subrayado */
		.contact-link {
			color: var(--text);
			font-weight: 600;
			text-decoration: underline;
			text-decoration-color: var(--accent);
			text-underline-offset: 0.2em;
			text-decoration-thickness: 1px;
		}

		.contact-link:hover {
			text-decoration-thickness: 2px;
		}
	}
</style>
