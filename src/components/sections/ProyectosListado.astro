---
/**
 * Fichas de proyectos (site.proyectos.items). Lo usan la sección de la home y la página /proyectos.
 * Hoy hay una sola ficha pendiente; para publicar un producto se agrega un elemento en site.ts.
 */
import { site } from '../../content/site';

const { items } = site.proyectos;
const { mailto } = site.contact;

// Parte la descripción para enlazar la palabra de contacto al correo
const withContactLink = (text: string, word?: string) => {
	if (!word || !text.includes(word)) return { before: text, word: '', after: '' };
	const at = text.lastIndexOf(word);
	return { before: text.slice(0, at), word, after: text.slice(at + word.length) };
};
---

<!-- role="list": Safari/VoiceOver quita la semántica de lista cuando list-style es none -->
<ul role="list" class="grid gap-4 sm:gap-6">
	{
		items.map((item) => {
			const desc = withContactLink(item.description, item.contactWord);
			return (
				<li>
					<article data-proyecto class="proyecto">
						<p class="status">
							<span class="status-dot" aria-hidden="true" />
							{item.status}
						</p>
						<h3 class="mt-4 text-lg font-semibold sm:text-xl">{item.name}</h3>
						<p class="mt-2 max-w-[52ch] leading-relaxed text-pretty text-text-secondary">
							{desc.before}
							{desc.word && (
								<a href={mailto} class="contact-link">
									{desc.word}
								</a>
							)}
							{desc.after}
						</p>
					</article>
				</li>
			);
		})
	}
</ul>

<style>
	@layer components {
		.proyecto {
			padding: 1.5rem;
			border-radius: 1.25rem;
			background: var(--surface);
			border: 1px solid var(--border);
		}

		@media (width >= 40rem) {
			.proyecto {
				padding: 2rem;
			}
		}

		/* Estado: punto + texto, para que no dependa solo del color */
		.status {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.25rem 0.75rem;
			border-radius: 9999px;
			border: 1px solid var(--border);
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--text);
		}

		.status-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 9999px;
			background: var(--accent);
		}

		/* Texto en --text (contraste AA en claro); el acento va en el subrayado */
		.contact-link {
			color: var(--text);
			font-weight: 600;
			text-decoration: underline;
			text-decoration-color: var(--accent);
			text-underline-offset: 0.2em;
			text-decoration-thickness: 1px;
		}

		.contact-link:hover {
			text-decoration-thickness: 2px;
		}
	}
</style>
