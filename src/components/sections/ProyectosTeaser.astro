---
import Container from '../layout/Container.astro';
import { site } from '../../content/site';

const { id, title, intro, status, card } = site.proyectos;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-section">
	<Container>
		<div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
			<h2 id={`${id}-title`} class="font-mono text-3xl font-bold tracking-tight">{title}</h2>
			<p class="text-sm text-text-secondary">{status}</p>
		</div>
		<p class="mt-4 max-w-[60ch] leading-relaxed text-text-secondary">{intro}</p>
		<article class="mt-10 max-w-md rounded-2xl border border-border bg-surface p-6">
			<h3 class="font-semibold">{card.name}</h3>
			<p class="mt-1 text-sm text-text-secondary">{card.status}</p>
			<p class="mt-4 leading-relaxed text-text-secondary">{card.description}</p>
		</article>
	</Container>
</section>
