---
import Container from '../layout/Container.astro';
import BrandMark from '../brand/BrandMark.astro';
import { site } from '../../content/site';

const { id, title, body, brandOrigin, cta, ctaNote } = site.quienesSomos;

// La marca {JR_} se muestra con la tipografía y los colores del logo dentro del texto
const BRAND = '{JR_}';
---

<!-- Un solo bloque de texto sobre la empresa: sin fotos ni tarjetas por persona -->
<section id={id} aria-labelledby={`${id}-title`} class="py-section">
	<Container class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
		<h2 id={`${id}-title`} class="section-title">{title}</h2>

		<div>
			<div class="flex max-w-prose flex-col gap-4 text-lg leading-relaxed text-pretty text-text-secondary sm:text-xl">
				{body.map((paragraph) => <p>{paragraph}</p>)}
				<p>
					{brandOrigin.split(BRAND).map((part, i) => (
						<>
							{i > 0 && <BrandMark />}
							{part}
						</>
					))}
				</p>
			</div>

			<div class="mt-8">
				<a href={cta.href} class="quienes-cta border border-border text-text hover:border-text-secondary hover:bg-surface">
					{cta.label}
				</a>
				<p class="mt-3 text-sm text-text-secondary">{ctaNote}</p>
			</div>
		</div>
	</Container>
</section>

<style>
	@layer components {
		/* Botón secundario, igual al del hero */
		.quienes-cta {
			display: inline-flex;
			align-items: center;
			min-height: 3rem;
			padding-inline: 1.5rem;
			border-radius: 9999px;
			font-weight: 600;
			transition:
				transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
				background-color 150ms ease,
				border-color 150ms ease;
		}

		.quienes-cta:active {
			transform: scale(0.97);
		}

		@media (prefers-reduced-motion: reduce) {
			.quienes-cta {
				transition:
					background-color 150ms ease,
					border-color 150ms ease;
			}

			.quienes-cta:active {
				transform: none;
			}
		}
	}
</style>
