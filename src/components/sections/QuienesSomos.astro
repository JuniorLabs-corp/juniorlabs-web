---
import Container from '../layout/Container.astro';
import { site } from '../../content/site';

const { id, title, paragraphs, founders } = site.quienesSomos;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-section">
	<Container class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
		<div>
			<h2 id={`${id}-title`} class="section-title">{title}</h2>
			<div class="mt-4 flex max-w-[38ch] flex-col gap-4 text-lg leading-relaxed text-pretty text-text-secondary">
				{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<!-- max-w: en tableta los recuadros no crecen más que en escritorio -->
		<div class="max-w-xl lg:max-w-none">
			<!-- role="list": Safari/VoiceOver quita la semántica de lista cuando list-style es none -->
			<ul role="list" class="grid grid-cols-2 gap-4 sm:gap-6">
				{
					founders.map((founder) => (
						<li data-founder>
							{/* Inicial de cada fundador en lugar de foto: J y R forman {JR_} */}
							<div data-initial class="initial" aria-hidden="true">
								{founder.initial}
							</div>
							<p class="mt-3 text-sm leading-snug break-words text-text-secondary">{founder.line}</p>
						</li>
					))
				}
			</ul>
		</div>
	</Container>
</section>

<style>
	@layer components {
		.initial {
			display: grid;
			place-items: center;
			aspect-ratio: 1;
			border-radius: 1.25rem;
			background: var(--surface);
			border: 1px solid var(--border);
			color: var(--text);
			font-family: var(--font-mono);
			font-weight: 700;
			font-size: clamp(3.5rem, 2rem + 6vw, 6rem);
			line-height: 1;
			letter-spacing: -0.04em;
		}
	}
</style>
