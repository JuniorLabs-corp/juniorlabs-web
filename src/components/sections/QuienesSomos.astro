---
import Container from '../layout/Container.astro';
import { site } from '../../content/site';

const { id, title, paragraphs, pending } = site.quienesSomos;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-section">
	<Container>
		<h2 id={`${id}-title`} class="font-mono text-3xl font-bold tracking-tight">{title}</h2>
		<div class="mt-4 flex max-w-[60ch] flex-col gap-4 leading-relaxed text-text-secondary">
			{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<ul class="mt-8 flex flex-col gap-2 text-sm text-text-secondary">
			{pending.map((item) => <li>{item}</li>)}
		</ul>
	</Container>
</section>
