---
/**
 * Logo {JR_} → cohete. Solo CSS scroll-driven animations (0 KB de JS):
 *   - Hero: con los primeros 6–12rem de scroll (según el ancho) el logo se arma en cohete, toma impulso y despega.
 *   - El vuelo por las secciones vive en RocketFlight.astro (≥ 84rem).
 *   - El aterrizaje vive en LandingPad.astro (footer).
 *
 * Nada se mueve sin scroll: si el usuario se detiene, todo se detiene (WCAG 2.2.2).
 * Sin soporte de animation-timeline o con prefers-reduced-motion: el logo queda quieto.
 * Decorativo (aria-hidden); no recibe foco ni tapa texto: vive dentro del recuadro reservado del hero.
 */
import RocketArt from './RocketArt.astro';
---

<div class="logo-cohete" data-logo-cohete>
	<RocketArt variant="hero" class="h-auto max-h-full w-full" />
</div>

<style>
	.logo-cohete {
		/*
			Recorrido de scroll de toda la secuencia. En una columna (< 64rem) el recuadro está arriba
			y se mete bajo el header fijo pronto, así que la secuencia es más corta para verse completa.
		*/
		--rocket-range: 6rem;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
	}

	@media (width >= 64rem) {
		.logo-cohete {
			--rocket-range: 12rem;
		}
	}

	@supports (animation-timeline: scroll()) and (animation-range: 0 1px) {
		@media (prefers-reduced-motion: no-preference) {
			/*
				Etapas sobre los primeros --rocket-range de scroll de la página (6rem en una columna, 12rem en dos):
				  0–50%    ensamble (ease-in-out fuerte)
				  50–58%   anticipación: se agacha y se inclina un poco
				  58–62%   se recupera
				  62–100%  despegue acelerando (ease-in)
			*/
			.logo-cohete :global(.rocket-art .piece),
			.logo-cohete :global(.rocket-art .rocket),
			.logo-cohete :global(.rocket-art .flame),
			.logo-cohete :global(.rocket-art .glass),
			.logo-cohete :global(.rocket-art .p-labs),
			.logo-cohete :global(.rocket-art .p-foot) {
				animation-duration: auto;
				animation-fill-mode: both;
				animation-timing-function: linear;
				animation-timeline: scroll(root);
				animation-range: 0 var(--rocket-range);
			}

			.logo-cohete :global(.rocket-art .piece) {
				animation-name: rocket-assemble;
			}

			.logo-cohete :global(.rocket-art .p-labs),
			.logo-cohete :global(.rocket-art .p-foot) {
				animation-name: rocket-assemble, rocket-fade-out;
			}

			.logo-cohete :global(.rocket-art .glass) {
				animation-name: rocket-glass;
			}

			.logo-cohete :global(.rocket-art .rocket) {
				transform-origin: 174px 109px;
				animation-name: rocket-launch;
			}

			.logo-cohete :global(.rocket-art .flame) {
				animation-name: rocket-flame;
			}

			.logo-cohete :global(.rocket-art .flame-inner) {
				transform-origin: 174px 109px;
				animation-name: rocket-flame-core;
				animation-duration: auto;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
				animation-range: 0 var(--rocket-range);
			}

			.logo-cohete :global(.rocket-art .puff) {
				animation-name: rocket-puff;
				animation-duration: auto;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
				animation-range: calc(var(--rocket-range) * var(--start)) calc(var(--rocket-range) * 1.08);
			}
		}
	}

	@keyframes rocket-assemble {
		0% {
			transform: none;
			animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
		}
		50%,
		100% {
			transform: var(--to);
		}
	}

	@keyframes rocket-fade-out {
		0% {
			opacity: 1;
			animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
		}
		30%,
		100% {
			opacity: 0;
		}
	}

	@keyframes rocket-glass {
		0%,
		38% {
			opacity: 0;
		}
		50%,
		100% {
			opacity: 1;
		}
	}

	@keyframes rocket-launch {
		0% {
			transform: none;
			animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
		}
		50% {
			/* armado: crece un 15% para llenar el recuadro */
			transform: scale(1.15);
			animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
		}
		56% {
			/* anticipación: se agacha 3 unidades y se inclina */
			transform: translate(0, 3px) rotate(-2deg) scale(1.17, 1.11);
			animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
		}
		62% {
			transform: translate(0, -2px) rotate(0.5deg) scale(1.15);
			animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
		}
		100% {
			transform: translate(0, -230px) rotate(0deg) scale(1.15);
		}
	}

	/* Fuego: crece y "parpadea" con el scroll (no con el tiempo) */
	@keyframes rocket-flame {
		0%,
		52% {
			opacity: 0;
			transform: scale(0.6, 0);
		}
		56% {
			opacity: 1;
			transform: scale(0.8, 0.35);
		}
		59% {
			transform: scale(0.9, 0.55);
		}
		62% {
			transform: scale(1, 0.95);
		}
		67% {
			transform: scale(0.94, 1.25);
		}
		72% {
			transform: scale(1.06, 1);
		}
		78% {
			transform: scale(0.92, 1.4);
		}
		84% {
			transform: scale(1.05, 1.1);
		}
		90% {
			transform: scale(0.95, 1.45);
		}
		100% {
			opacity: 1;
			transform: scale(1, 1.3);
		}
	}

	@keyframes rocket-flame-core {
		0%,
		60% {
			transform: scale(1, 0.7);
		}
		65% {
			transform: scale(0.85, 1.15);
		}
		71% {
			transform: scale(1.1, 0.85);
		}
		76% {
			transform: scale(0.9, 1.2);
		}
		83% {
			transform: scale(1.05, 0.9);
		}
		91% {
			transform: scale(0.88, 1.25);
		}
		100% {
			transform: scale(1, 1);
		}
	}

	/* Humo: cada bocanada sale en su momento (--start) y se abre hacia su lado (--dx) */
	@keyframes rocket-puff {
		0% {
			opacity: 0;
			transform: translate(0, 0) scale(0.2);
			animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
		}
		35% {
			opacity: 0.6;
			transform: translate(var(--dx), var(--dy)) scale(1);
		}
		100% {
			opacity: 0;
			transform: translate(calc(var(--dx) * 2), calc(var(--dy) * 2.5)) scale(var(--s));
		}
	}
</style>
