---
/**
 * Plataforma de aterrizaje en el footer. Es el destino del cohete de RocketScene (GSAP):
 * el script lee la posición de [data-rocket-pad] para posarlo aquí.
 * Sin animación (sin JS, reduced motion o antes de cargar GSAP) muestra el cohete ya posado.
 * Decorativo (aria-hidden); su caja está reservada y no tapa enlaces ni texto.
 */
import RocketStatic from './RocketStatic.astro';
---

<div class="landing-pad" data-rocket-pad aria-hidden="true">
	<RocketStatic class="pad-rocket" />
	<span class="pad-shadow"></span>
</div>

<style>
	.landing-pad {
		position: relative;
		width: 5rem;
		height: 8rem;
	}

	/* :global — la clase va en la raíz de RocketStatic, que no recibe el alcance de este componente */
	.landing-pad :global(.pad-rocket) {
		position: absolute;
		left: 50%;
		bottom: 0.25rem;
		width: 3.5rem;
		margin-left: -1.75rem;
	}

	.pad-shadow {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: 4rem;
		height: 0.375rem;
		margin-left: -2rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--text-secondary) 30%, transparent);
	}

	/* Con la escena animada activa, el cohete que aterriza es el de RocketScene */
	:global(html.rocket-on .pad-rocket) {
		visibility: hidden;
	}
</style>
