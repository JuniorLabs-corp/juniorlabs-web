---
/**
 * Botón de tema claro/oscuro (dos estados).
 * La primera visita sigue al sistema; al tocarlo se fija el modo contrario en <html data-theme> y se
 * recuerda en localStorage. El modo guardado se aplica antes de pintar (script en BaseLayout).
 * El icono muestra el modo al que se cambia: luna en claro, sol en oscuro.
 * Sin JS no puede hacer nada, así que no se muestra.
 */
---

<button type="button" class="theme-toggle" aria-label="Cambiar tema" data-theme-toggle>
	<!-- Luna: visible en modo claro (cambia a oscuro) -->
	<svg class="theme-icon dark:hidden" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z"></path>
	</svg>
	<!-- Sol: visible en modo oscuro (cambia a claro) -->
	<svg class="theme-icon hidden dark:block" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
		></path>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
	const COLORS = { light: '#F4F7FA', dark: '#0B1730' } as const;

	type Theme = keyof typeof COLORS;
	const current = (): Theme => {
		const forced = root.dataset.theme;
		if (forced === 'light' || forced === 'dark') return forced;
		return systemDark.matches ? 'dark' : 'light';
	};

	const syncLabel = () => {
		button?.setAttribute('aria-label', current() === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
	};

	if (button) {
		syncLabel();
		button.addEventListener('click', () => {
			const next: Theme = current() === 'dark' ? 'light' : 'dark';
			root.classList.add('theme-anim'); // el giro del icono solo al cambiar, no al cargar
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				/* sin almacenamiento (modo privado): el cambio vale para esta página */
			}
			// Barra del navegador en móvil del mismo color que el fondo: una sola etiqueta sin media query
			// (con las dos, el navegador seguiría usando la del modo del sistema)
			const meta = document.createElement('meta');
			meta.name = 'theme-color';
			meta.content = COLORS[next];
			document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.remove());
			document.head.append(meta);
			syncLabel();
			document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
		});
		// Sin preferencia guardada, el botón sigue al sistema si este cambia
		systemDark.addEventListener('change', syncLabel);
	}
</script>

<style>
	@layer components {
		.theme-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.5rem;
			height: 2.5rem;
			flex-shrink: 0;
			border-radius: 9999px;
			border: 1px solid var(--border);
			color: var(--text);
			cursor: pointer;
			transition:
				transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
				border-color 150ms ease;
		}

		/* Sin JS el botón no haría nada */
		@media (scripting: none) {
			.theme-toggle {
				display: none;
			}
		}

		.theme-toggle:hover {
			border-color: var(--text-secondary);
		}

		.theme-toggle:active {
			transform: scale(0.97);
		}

		.theme-icon {
			width: 1.125rem;
			height: 1.125rem;
			fill: none;
			stroke: currentColor;
			stroke-width: 1.8;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		/* Al cambiar, el icono nuevo entra girando (solo tras un clic: la clase la pone el script) */
		:global(.theme-anim) .theme-icon {
			transition:
				transform 300ms cubic-bezier(0.23, 1, 0.32, 1),
				opacity 200ms ease;
		}

		@starting-style {
			:global(.theme-anim) .theme-icon {
				opacity: 0;
				transform: rotate(-90deg) scale(0.6);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.theme-toggle,
			:global(.theme-anim) .theme-icon {
				transition: none;
			}

			.theme-toggle:active {
				transform: none;
			}
		}
	}
</style>
