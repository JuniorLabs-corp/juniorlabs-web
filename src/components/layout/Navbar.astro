---
import Container from './Container.astro';
import Logo from '../brand/Logo.astro';
import { site } from '../../content/site';

const { brand, links, cta } = site.nav;
const panelId = 'menu-principal';

// Página actual: solo enlaces a páginas (no a anclas). '/proyectos' y '/proyectos/' cuentan igual.
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const current = normalize(Astro.url.pathname);
const isCurrent = (href: string) => !href.includes('#') && normalize(href) === current;
---

<div data-navbar>
	<!-- min-h + flex-wrap: con texto grande la barra baja a dos filas en vez de desbordarse -->
	<Container class="flex min-h-18 flex-wrap items-center justify-between gap-x-3 gap-y-2 py-2 sm:gap-x-6">
		<a href="/" class="shrink-0 rounded-md">
			<Logo label={brand} class="h-7 w-auto" />
		</a>

		<!-- Escritorio: enlaces en línea -->
		<nav aria-label="Principal" class="hidden lg:block">
			<ul class="flex gap-7 text-sm">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<a href={cta.href} class="nav-cta bg-accent text-on-accent">
				{cta.label}
			</a>
			<button
				type="button"
				class="menu-button lg:hidden"
				aria-expanded="false"
				aria-controls={panelId}
				data-menu-button
			>
				<span class="menu-icon" aria-hidden="true"><span></span></span>
				<span class="max-[24rem]:sr-only">Menú</span>
			</button>
		</div>
	</Container>

	<!-- Móvil y tableta: panel dentro del header, empuja el contenido en vez de taparlo -->
	<div id={panelId} class="menu-panel lg:hidden" hidden data-menu-panel>
		<Container class="pb-4">
			<nav aria-label="Principal">
				<ul class="flex flex-col">
					{
						links.map((link) => (
							<li>
								<a href={link.href} class="panel-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</Container>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-navbar]');
	const button = root?.querySelector<HTMLButtonElement>('[data-menu-button]');
	const panel = root?.querySelector<HTMLElement>('[data-menu-panel]');

	if (root && button && panel) {
		const desktop = window.matchMedia('(width >= 64rem)');

		const isOpen = () => button.getAttribute('aria-expanded') === 'true';
		const focusInside = (el: Element) => el.contains(document.activeElement);

		// El panel nunca pasa del borde inferior de la pantalla; si no cabe, se desplaza por dentro
		const fitPanel = () => {
			if (!isOpen()) return;
			panel.style.maxHeight = `${Math.max(0, window.innerHeight - panel.getBoundingClientRect().top)}px`;
		};

		const setOpen = (open: boolean, { restoreFocus = false } = {}) => {
			button.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
			if (open) fitPanel();
			if (!open && restoreFocus) button.focus();
		};

		button.addEventListener('click', () => setOpen(!isOpen()));

		// Elegir un enlace cierra el menú (la navegación al ancla sigue normal)
		panel.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setOpen(false);
		});

		// Escape cierra; el foco vuelve al botón solo si estaba dentro del header
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) setOpen(false, { restoreFocus: focusInside(root) });
		});

		// pointerdown en vez de click: iOS no dispara click al tocar texto no interactivo
		document.addEventListener('pointerdown', (event) => {
			if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
		});

		window.addEventListener('resize', fitPanel);

		// Al pasar a escritorio el CSS oculta el panel antes de este script, así que se recuerda
		// si el foco estaba ahí (focusout sin destino = el elemento desapareció, no que el usuario se movió)
		let focusWasInPanel = false;
		panel.addEventListener('focusin', () => (focusWasInPanel = true));
		panel.addEventListener('focusout', (event) => {
			if (event.relatedTarget) focusWasInPanel = false;
		});

		desktop.addEventListener('change', (event) => {
			if (!event.matches) return;
			setOpen(false);
			if (focusWasInPanel && (document.activeElement === document.body || focusInside(panel))) {
				root.querySelector<HTMLAnchorElement>('a[href="/"]')?.focus();
			}
			focusWasInPanel = false;
		});
	}
</script>

<style>
	@layer components {
		.nav-link {
			color: var(--text-secondary);
			transition: color 150ms ease;
		}

		.nav-link:hover {
			color: var(--text);
		}

		/* Página actual: más contraste y peso, no solo color */
		.nav-link[aria-current='page'],
		.panel-link[aria-current='page'] {
			color: var(--text);
			font-weight: 600;
		}

		.nav-cta {
			display: inline-flex;
			align-items: center;
			min-height: 2.5rem;
			padding-inline: 1rem;
			border-radius: 9999px;
			font-size: 0.875rem;
			font-weight: 600;
			transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		.menu-button {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			min-height: 2.5rem;
			padding-inline: 0.75rem;
			border-radius: 9999px;
			border: 1px solid var(--border);
			font-size: 0.875rem;
			font-weight: 600;
			color: var(--text);
			cursor: pointer;
			transition:
				transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
				border-color 150ms ease;
		}

		.menu-button:hover {
			border-color: var(--text-secondary);
		}

		.nav-cta:active,
		.menu-button:active {
			transform: scale(0.97);
		}

		/* Icono de dos líneas que se convierte en una X al abrir */
		.menu-icon {
			position: relative;
			width: 1rem;
			height: 0.75rem;
		}

		.menu-icon::before,
		.menu-icon::after {
			content: '';
			position: absolute;
			left: 0;
			width: 100%;
			height: 2px;
			border-radius: 1px;
			background: currentColor;
			transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		.menu-icon::before {
			top: 0.125rem;
		}

		.menu-icon::after {
			bottom: 0.125rem;
		}

		[aria-expanded='true'] .menu-icon::before {
			transform: translateY(0.1875rem) rotate(45deg);
		}

		[aria-expanded='true'] .menu-icon::after {
			transform: translateY(-0.1875rem) rotate(-45deg);
		}

		.menu-panel {
			overflow-y: auto;
			overscroll-behavior: contain;
			opacity: 1;
			transform: translateY(0);
			transition:
				opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
				transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		@starting-style {
			.menu-panel {
				opacity: 0;
				transform: translateY(-0.25rem);
			}
		}

		.panel-link {
			display: flex;
			align-items: center;
			min-height: 3rem;
			border-top: 1px solid var(--border);
			font-weight: 500;
			color: var(--text);
		}

		@media (prefers-reduced-motion: reduce) {
			.nav-cta,
			.menu-button,
			.menu-icon::before,
			.menu-icon::after {
				transition: none;
			}

			.nav-cta:active,
			.menu-button:active {
				transform: none;
			}

			.menu-panel {
				transform: none;
				transition: opacity 150ms ease;
			}

			@starting-style {
				.menu-panel {
					transform: none;
				}
			}
		}
	}
</style>
