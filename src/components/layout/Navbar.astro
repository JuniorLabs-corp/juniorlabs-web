---
import Container from './Container.astro';
import LogoLight from '../../assets/brand/logo-light.svg';
import LogoDark from '../../assets/brand/logo-dark.svg';
import { site } from '../../content/site';

const { brand, links, cta } = site.nav;
const panelId = 'menu-principal';
---

<div data-navbar>
	<Container class="flex h-18 items-center justify-between gap-3 sm:gap-6">
		<a href="/" class="shrink-0 rounded-md">
			<img
				src={LogoLight.src}
				width={LogoLight.width}
				height={LogoLight.height}
				alt={brand}
				class="h-7 w-auto dark:hidden"
			/>
			<img
				src={LogoDark.src}
				width={LogoDark.width}
				height={LogoDark.height}
				alt={brand}
				class="hidden h-7 w-auto dark:block"
			/>
		</a>

		<!-- Escritorio: enlaces en línea -->
		<nav aria-label="Principal" class="hidden lg:block">
			<ul class="flex gap-7 text-sm">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="nav-link">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<a href={cta.href} class="nav-cta bg-accent text-on-accent">
				{cta.label}
			</a>
			<button
				type="button"
				class="menu-button lg:hidden"
				aria-expanded="false"
				aria-controls={panelId}
				data-menu-button
			>
				<span class="menu-icon" aria-hidden="true"><span></span></span>
				<span class="max-[24rem]:sr-only">Menú</span>
			</button>
		</div>
	</Container>

	<!-- Móvil y tableta: panel dentro del header, empuja el contenido en vez de taparlo -->
	<div id={panelId} class="menu-panel lg:hidden" hidden data-menu-panel>
		<Container class="pb-4">
			<nav aria-label="Principal">
				<ul class="flex flex-col">
					{
						links.map((link) => (
							<li>
								<a href={link.href} class="panel-link">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</Container>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-navbar]');
	const button = root?.querySelector<HTMLButtonElement>('[data-menu-button]');
	const panel = root?.querySelector<HTMLElement>('[data-menu-panel]');

	if (root && button && panel) {
		const desktop = window.matchMedia('(width >= 64rem)');

		const setOpen = (open: boolean, { restoreFocus = false } = {}) => {
			button.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
			if (!open && restoreFocus) button.focus();
		};
		const isOpen = () => button.getAttribute('aria-expanded') === 'true';

		button.addEventListener('click', () => setOpen(!isOpen()));

		// Elegir un enlace cierra el menú (la navegación al ancla sigue normal)
		panel.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) setOpen(false, { restoreFocus: true });
		});

		document.addEventListener('click', (event) => {
			if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>

<style>
	@layer components {
		.nav-link {
			color: var(--text-secondary);
			transition: color 150ms ease;
		}

		.nav-link:hover {
			color: var(--text);
		}

		.nav-cta {
			display: inline-flex;
			align-items: center;
			min-height: 2.5rem;
			padding-inline: 1rem;
			border-radius: 9999px;
			font-size: 0.875rem;
			font-weight: 600;
			transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		.menu-button {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			min-height: 2.5rem;
			padding-inline: 0.75rem;
			border-radius: 9999px;
			border: 1px solid var(--border);
			font-size: 0.875rem;
			font-weight: 600;
			color: var(--text);
			cursor: pointer;
			transition:
				transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
				border-color 150ms ease;
		}

		.menu-button:hover {
			border-color: var(--text-secondary);
		}

		.nav-cta:active,
		.menu-button:active {
			transform: scale(0.97);
		}

		/* Icono de dos líneas que se convierte en una X al abrir */
		.menu-icon {
			position: relative;
			width: 1rem;
			height: 0.75rem;
		}

		.menu-icon::before,
		.menu-icon::after {
			content: '';
			position: absolute;
			left: 0;
			width: 100%;
			height: 2px;
			border-radius: 1px;
			background: currentColor;
			transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		.menu-icon::before {
			top: 0.125rem;
		}

		.menu-icon::after {
			bottom: 0.125rem;
		}

		[aria-expanded='true'] .menu-icon::before {
			transform: translateY(0.25rem) rotate(45deg);
		}

		[aria-expanded='true'] .menu-icon::after {
			transform: translateY(-0.25rem) rotate(-45deg);
		}

		.menu-panel {
			opacity: 1;
			transform: translateY(0);
			transition:
				opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
				transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
		}

		@starting-style {
			.menu-panel {
				opacity: 0;
				transform: translateY(-0.25rem);
			}
		}

		.panel-link {
			display: flex;
			align-items: center;
			min-height: 3rem;
			border-top: 1px solid var(--border);
			font-weight: 500;
			color: var(--text);
		}

		@media (prefers-reduced-motion: reduce) {
			.nav-cta,
			.menu-button,
			.menu-icon::before,
			.menu-icon::after {
				transition: none;
			}

			.nav-cta:active,
			.menu-button:active {
				transform: none;
			}

			.menu-panel {
				transform: none;
				transition: opacity 150ms ease;
			}

			@starting-style {
				.menu-panel {
					transform: none;
				}
			}
		}
	}
</style>
